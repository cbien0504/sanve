# Copy to .env for local development: `cp .env.example .env` (make up does it for you).
# These values are for a laptop only. Production secrets come from a secret manager
# (Kubernetes Secret / AWS Secrets Manager...) and the API refuses to start with weak ones.

POSTGRES_USER=sanve
POSTGRES_PASSWORD=sanve-local-password
POSTGRES_DB=sanve

RABBITMQ_USER=sanve
RABBITMQ_PASSWORD=sanve-local-password

JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
PAYMENT_API_KEY=dev-payment-api-key-change-me
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Created on first start by the migrate container, used by scripts/demo.py
BOOTSTRAP_ADMIN_EMAIL=admin@sanve.local
BOOTSTRAP_ADMIN_PASSWORD=Admin-local-123

# Business timings (seconds). Shorten them to watch the janitor expire holds/orders.
HOLD_TTL_SECONDS=600
ORDER_TTL_SECONDS=900

# Fake payment gateway behaviour: share of requests answered 503, artificial latency,
# and whether every webhook is delivered twice (to exercise idempotent consumers).
PAYMENT_FAILURE_RATE=0.1
PAYMENT_MAX_LATENCY_MS=300
PAYMENT_DUPLICATE_WEBHOOKS=true

GRAFANA_ADMIN_PASSWORD=admin-local-password

# Optional: errors are also sent to Sentry when set.
SENTRY_DSN=
